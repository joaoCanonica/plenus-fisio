---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/figtree/latin-400.css';
import '@fontsource/figtree/latin-600.css';
import '@fontsource/figtree/latin-700.css';
import '../styles/global.css';
// Fontes críticas pré-carregadas para evitar troca tardia (CLS).
import serif400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import figtree400 from '@fontsource/figtree/files/figtree-latin-400-normal.woff2?url';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import Consentimento from '../components/Consentimento.astro';
import Entrada from '../components/Entrada.astro';
import BarraMobile from '../components/BarraMobile.astro';
import { EM_PRODUCAO } from '../lib/modo.ts';
import { listarPendencias } from '../lib/validacao.ts';
import { identificacao } from '../lib/contato.ts';
import { cssDoTema, themeColor } from '../lib/tema.ts';
import { jsonLd } from '../lib/schema.ts';
import { clinica } from '../config/profile.config.ts';

interface Trilha { nome: string; caminho: string }
interface Props {
  titulo: string;
  descricao: string;
  noindex?: boolean;
  landing?: boolean;
  preload?: { srcset: string; sizes: string; type: string } | undefined;
  /** BreadcrumbList; padrão: só a página inicial. */
  trilha?: readonly Trilha[];
  /** Inclui FAQPage no JSON-LD (só a home). */
  faq?: boolean;
}
const { titulo, descricao, noindex = false, landing = false, preload, trilha = [{ nome: 'Início', caminho: '/' }], faq = false } = Astro.props;
const pend = EM_PRODUCAO ? [] : listarPendencias();
const nBloq = pend.filter((p) => p.nivel === 'bloqueante').length;
const canonico = new URL(Astro.url.pathname, Astro.site);
const site = Astro.site ?? new URL('https://example.com');
const ogImagem = new URL('/og.png', site);
// Dados estruturados só em produção (com os dados obrigatórios confirmados).
const ld = EM_PRODUCAO && !noindex ? jsonLd(site, { faq, trilha }) : null;
---
<!doctype html>
<html lang="pt-BR" data-landing={landing ? 'on' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="author" content={identificacao()} />
    <meta name="theme-color" content={themeColor()} />
    <style is:global set:html={cssDoTema()}></style>
    {EM_PRODUCAO && !noindex ? <link rel="canonical" href={canonico} /> : <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={clinica.nomeFantasia.valor} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${clinica.nomeFantasia.valor}, fisioterapia e Pilates em Lages (SC)`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    {preload && <link rel="preload" as="image" imagesrcset={preload.srcset} imagesizes={preload.sizes} type={preload.type} fetchpriority="high" />}
    <link rel="preload" as="font" type="font/woff2" href={serif400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={figtree400} crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {ld && <script type="application/ld+json" set:html={ld} />}
    <script is:inline>
      // .js para revelações; .entrada ("O Oval") uma vez por sessão, nunca com reduced-motion.
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        try {
          if (h.dataset.landing === 'on' && !matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('plenus-entrada')) {
            sessionStorage.setItem('plenus-entrada', '1');
            h.classList.add('entrada');
          }
        } catch (e) {}
        try {
          // Tema escolhido pela pessoa (só existe depois de um clique no seletor).
          var t = localStorage.getItem('plenus-tema');
          if (t === 'claro' || t === 'escuro') h.setAttribute('data-tema', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {landing && <Entrada />}
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    {!EM_PRODUCAO && (
      <aside aria-label="Versão em revisão"><a class="faixa-preview" href="/pendencias">
        Em revisão · versão provisória, não indexada · {nBloq} pendência(s) bloqueante(s) · ver lista
      </a></aside>
    )}
    <Cabecalho />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Rodape />
    <Consentimento />
    {landing && <BarraMobile />}
    <script>
      import '../scripts/revelar.ts';
    </script>
  </body>
</html>

<style is:global>
  .faixa-preview {
    display: block;
    padding: 0.45rem var(--gutter);
    background: var(--aviso-fundo);
    color: var(--aviso-texto);
    font: 700 0.75rem/1.4 var(--fonte-texto);
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
    border-bottom: 1px dashed var(--aviso-borda);
  }
  main:focus { outline: none; }
</style>
