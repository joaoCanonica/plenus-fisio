---
import Marca from './Marca.astro';
import Icone from './ui/Icon.astro';
import { clinica } from '../config/profile.config.ts';
import { telefoneExibicao, whatsappUrl } from '../lib/contato.ts';
import { secoes } from '../lib/secoes.ts';
const base = Astro.url.pathname === '/' ? '' : '/';
// Itens de slot de vídeo só entram quando o slot renderiza (ver lib/secoes.ts).
const links = secoes().filter((s) => s.noMenu).map((s) => [s.rotulo, s.id] as const);
---
<header class="cab" data-cab>
  <div class="wrap cab__in">
    <a class="cab__marca" href="/" aria-label={`${clinica.nomeFantasia.valor}, página inicial`}>
      <Marca class="cab__logo" />
      <span class="cab__nome">
        <strong>{clinica.nomeFantasia.valor}</strong>
      </span>
    </a>
    <nav aria-label="Seções">
      <ul class="cab__nav">
        {links.map(([rotulo, id]) => <li><a href={`${base}#${id}`}>{rotulo}</a></li>)}
      </ul>
    </nav>
    <div class="tema" role="group" aria-label="Tema de cores" data-tema-seletor>
      <button type="button" data-valor="auto" aria-pressed="true" title="Automático (igual ao aparelho)"><span class="sr-only">Tema automático</span><span aria-hidden="true">A</span></button>
      <button type="button" data-valor="claro" aria-pressed="false" title="Claro"><span class="sr-only">Tema claro</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></svg></button>
      <button type="button" data-valor="escuro" aria-pressed="false" title="Escuro"><span class="sr-only">Tema escuro</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg></button>
    </div>
    <a class="btn cab__cta" href={whatsappUrl()} rel="noopener" target="_blank">
      <Icone nome="whatsapp" /><span><span class="sr-only">WhatsApp </span>{telefoneExibicao()}</span><span class="sr-only"> (abre em nova aba)</span>
    </a>
  </div>
</header>

<style>
  .cab {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--fundo) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .cab[data-rolado] { border-bottom-color: var(--linha); }
  .cab__in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 4.5rem;
  }
  .cab__marca {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--texto);
    margin-right: auto;
  }
  .cab :global(.cab__logo) { width: 2.6rem; height: 2.4rem; flex: none; color: var(--destaque); }
  .cab__nome { display: grid; line-height: 1.15; white-space: nowrap; }
  .cab__nome strong { font: 500 1.05rem/1.2 var(--fonte-display); }
  .cab__nome small { font-size: 0.72rem; color: var(--texto-suave); letter-spacing: 0.04em; }
  .cab__nav {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cab__nav a {
    color: var(--texto);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    padding-block: 0.5rem;
    background: linear-gradient(var(--destaque), var(--destaque)) left bottom / 0 1px no-repeat;
    transition: background-size 0.4s var(--ease);
  }
  .cab__nav a:hover { background-size: 100% 1px; }
  .cab__cta { min-height: 2.6rem; padding: 0.6rem 1rem; white-space: nowrap; }
  .cab__nav a { white-space: nowrap; }
  .cab__in { gap: 1.25rem; }
  .tema { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--linha); border-radius: 0.6rem; }
  .tema button {
    display: grid; place-items: center; width: 2rem; height: 2rem; padding: 0;
    border: 0; border-radius: 0.45rem; background: transparent; color: var(--texto-suave);
    font: 700 0.78rem/1 var(--fonte-texto); cursor: pointer;
  }
  .tema svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .tema button[aria-pressed='true'] { background: var(--acao); color: var(--acao-texto); }
  @media (max-width: 74rem) {
    nav { display: none; }
  }
  @media (max-width: 26rem) {
    .cab__nome small { display: none; }
    .cab__cta span:not(.sr-only) { display: none; }
    .cab__cta { padding: 0.6rem; aspect-ratio: 1; }
  }
</style>

<script>
  // Seletor de tema: Automático (aparelho), Claro, Escuro. A escolha só é gravada
  // depois do clique (preferência funcional, fica no navegador; ver /privacidade).
  {
    const html = document.documentElement;
    const botoes = [...document.querySelectorAll<HTMLButtonElement>('[data-tema-seletor] button')];
    const marcar = (v: string) => botoes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset['valor'] === v)));
    marcar(html.getAttribute('data-tema') ?? 'auto');
    botoes.forEach((b) =>
      b.addEventListener('click', () => {
        const v = b.dataset['valor'] ?? 'auto';
        if (v === 'auto') html.removeAttribute('data-tema');
        else html.setAttribute('data-tema', v);
        try { localStorage.setItem('plenus-tema', v); } catch { /* sem armazenamento: vale só nesta página */ }
        marcar(v);
      }),
    );
  }
  const cab = document.querySelector<HTMLElement>('[data-cab]');
  if (cab) {
    const sentinela = () => cab.toggleAttribute('data-rolado', window.scrollY > 8);
    sentinela();
    addEventListener('scroll', sentinela, { passive: true });
  }
</script>
