---
import Marca from './Marca.astro';
import Identificacao from './Identificacao.astro';
import { clinica } from '../config/profile.config.ts';
import { exibir } from '../lib/modo.ts';
import { enderecoTexto, equipeVisivel, horariosTexto, telefoneExibicao } from '../lib/clinica.ts';
import { instagramUrl, revogacaoUrl, whatsappUrl } from '../lib/contato.ts';
const c = clinica;
const ig = instagramUrl();
const horarios = horariosTexto();
const telefone = exibir(c.telefone);
const gmn = exibir(c.googleMeuNegocio);
const ano = new Date().getFullYear();
// Profissionais citados: só com nome completo + CREFITO.
const equipe = equipeVisivel();
---
<footer class="rod tom-claro">
  <div class="wrap rod__grade">
    <div class="rod__marca">
      <Marca class="rod__logo" variante="oval" />
      <p class="rod__frase">{c.nomeFantasia.valor}</p>
    </div>
    <div>
      <h2 class="rod__h">Identificação</h2>
      <Identificacao />
      {equipe.length > 0 && (
        <>
          <h2 class="rod__h rod__h--esp">Fisioterapeutas</h2>
          <ul class="rod__equipe">{equipe.map((p) => <li>{p.nomeCompleto} · {p.registro}</li>)}</ul>
        </>
      )}
    </div>
    <div>
      <h2 class="rod__h">Endereço</h2>
      <address>{enderecoTexto()}</address>
      {horarios && <p class="rod__info">{horarios}</p>}
      {telefone && <p class="rod__info">Telefone: {telefoneExibicao(telefone)}</p>}
      <h2 class="rod__h">Links</h2>
      <ul class="rod__links">
        <li><a href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp</a></li>
        {ig && <li><a href={ig} target="_blank" rel="noopener">Instagram</a></li>}
        {gmn && <li><a href={gmn} target="_blank" rel="noopener">Perfil no Google</a></li>}
        <li><a href="/privacidade">Política de privacidade e cookies</a></li>
        <li><button type="button" class="rod__btn" data-reabrir-consentimento>Preferências de cookies</button></li>
      </ul>
      <h2 class="rod__h">Imagens de pacientes</h2>
      <ul class="rod__links">
        <li><a href={revogacaoUrl()} target="_blank" rel="noopener">Pedir retirada de imagem ou vídeo (revogar o TCLE)<span class="sr-only"> (abre o WhatsApp em nova aba)</span></a></li>
        <li><a href="/privacidade#revogacao">Como funciona a retirada</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap rod__base">
    <p>
      © {ano} {c.nomeFantasia.valor}. As informações deste site têm caráter educativo e
      não substituem a consulta com profissional de saúde. Este site não agenda
      atendimentos nem coleta dados de saúde.
    </p>
  </div>
</footer>

<style>
  .rod {
    padding-block: 4.5rem 2rem;
    border-top: 1px solid var(--linha);
  }
  .rod a { color: var(--destaque); }
  .rod :global(dt) { color: var(--texto-suave); }
  .rod :global(.id__link) { color: var(--destaque); }
  .rod__grade {
    display: grid;
    gap: 3rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .rod :global(.rod__logo) { width: 7rem; height: auto; color: var(--destaque); }
  .rod__frase {
    font: 400 1.25rem/1.4 var(--fonte-display);
    margin-top: 1.25rem;
    max-width: 18rem;
    color: var(--texto);
  }
  .rod__h {
    font: 700 0.7rem/1 var(--fonte-texto);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-suave);
    margin-bottom: 1rem;
  }
  .rod__h:not(:first-child) { margin-top: 2rem; }
  address { font-style: normal; }
  .rod__info { margin-top: 0.4rem; color: var(--texto-suave); }
  .rod__h--esp { margin-top: 1.5rem; }
  .rod__equipe { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; font-size: 0.92rem; }
  .rod__links { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .rod__btn {
    font: inherit;
    color: var(--destaque);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    text-align: left;
  }
  .rod__base {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linha);
    font-size: 0.82rem;
    color: var(--texto-suave);
  }
</style>
