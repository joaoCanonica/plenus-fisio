---
// Assinatura "O Oval": entrada da landing, uma vez por sessão.
// Tela no verde da marca → a oval se desenha → PLENUS aparece → a oval se
// expande como máscara e revela o hero (que está no DOM desde o início).
// - Só roda com html.entrada (script inline no <head>: sem reduced-motion e
//   ainda não vista nesta sessão). Sem a classe, nada aparece.
// - "Pular" (botão e Esc), rede de segurança de 5 s, total de 3 s.
// - As duas figuras do logo NÃO entram: não há vetor fiel (docs/marca/LOGO.md).
import trace from '../../assets-originais/marca/derivados/plenus-palavra-trace.svg?raw';
const g = trace
  .slice(trace.indexOf('<g '), trace.lastIndexOf('</g>') + 4)
  .replace(/fill="[^"]*"/, 'fill="currentColor"');
// Palavra (trace 2160x560) dentro da oval de 400x560.
const palavra = `<g transform="translate(60 248) scale(${280 / 2160})">${g}</g>`;
---
<div class="entrada tom-verde" data-entrada>
  <div class="entrada__palco" aria-hidden="true">
    <svg class="entrada__svg" viewBox="0 0 400 560" focusable="false">
      <ellipse class="entrada__oval" cx="200" cy="280" rx="172" ry="250" pathLength="1" />
      <g class="entrada__palavra" set:html={palavra} />
    </svg>
  </div>
  <button type="button" class="entrada__pular" data-entrada-pular>Pular introdução</button>
</div>

<style>
  @property --r {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  .entrada { display: none; }
  :global(html.entrada) .entrada {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    pointer-events: none;
    background: var(--fundo);
    color: var(--texto);
    /* Buraco oval (proporção da oval do logo) que cresce e revela o hero. */
    --r: 0px;
    -webkit-mask: radial-gradient(calc(var(--r) * 0.69) var(--r) at 50% 50%, transparent 98%, currentColor 100%);
    mask: radial-gradient(calc(var(--r) * 0.69) var(--r) at 50% 50%, transparent 98%, currentColor 100%);
    animation: entrada-revela 1s cubic-bezier(0.6, 0, 0.2, 1) 2s forwards;
  }
  .entrada__svg { width: min(58vw, 42vh); height: auto; overflow: visible; }
  .entrada__oval {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: entrada-traco 1.1s cubic-bezier(0.45, 0, 0.2, 1) 0.1s forwards;
  }
  .entrada__palavra { opacity: 0; transform: translateY(8px); animation: entrada-palavra 0.7s ease-out 0.85s forwards; }
  .entrada__palco { animation: entrada-some 0.35s ease-in 2s forwards; }
  .entrada__pular {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    pointer-events: auto;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid currentColor;
    background: transparent;
    color: var(--texto);
    font: 600 0.9rem/1 var(--fonte-texto);
    cursor: pointer;
    animation: entrada-some 0.3s ease-in 2s forwards;
  }
  .entrada__pular:focus-visible { outline: 3px solid var(--foco); outline-offset: 3px; }
  @keyframes entrada-traco { to { stroke-dashoffset: 0; } }
  @keyframes entrada-palavra { to { opacity: 1; transform: none; } }
  @keyframes entrada-some { to { opacity: 0; visibility: hidden; } }
  @keyframes entrada-revela {
    0% { --r: 21vh; }
    99% { --r: 160vmax; visibility: visible; }
    100% { --r: 160vmax; visibility: hidden; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.entrada) .entrada { display: none; }
  }
</style>

<script>
  // Encerra a entrada: fim da animação, "Pular", Esc ou rede de segurança (5 s).
  const el = document.querySelector<HTMLElement>('[data-entrada]');
  const html = document.documentElement;
  if (el && html.classList.contains('entrada')) {
    const fim = () => {
      html.classList.remove('entrada');
      removeEventListener('keydown', esc);
    };
    const esc = (e: KeyboardEvent) => { if (e.key === 'Escape') fim(); };
    el.addEventListener('animationend', (e) => { if (e.target === el) fim(); });
    el.querySelector('[data-entrada-pular]')?.addEventListener('click', () => {
      fim();
      document.getElementById('conteudo')?.focus({ preventScroll: true });
    });
    addEventListener('keydown', esc);
    setTimeout(fim, 5000);
  }
</script>
