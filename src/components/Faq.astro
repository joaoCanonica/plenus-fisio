---
// Perguntas frequentes: <details> nativo (sem JS). Respostas autossuficientes,
// também publicadas como FAQPage (JSON-LD) para busca e IA.
import { copy } from '../config/copy.config.ts';
const c = copy.faq;
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.itens.map((f) => ({ '@type': 'Question', name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })),
});
---
{c.itens.length > 0 && (
<section id="faq" class="sec faq tom-claro" aria-labelledby="faq-titulo">
  <script type="application/ld+json" set:html={ld} />
  <div class="wrap faq__grade">
    <div data-revelar>
      <h2 id="faq-titulo" class="titulo">{c.titulo}</h2>
    </div>
    <div class="faq__lista">
      {c.itens.map((f) => (
        <details>
          <summary><h3>{f.pergunta}</h3><span class="faq__mais" aria-hidden="true"></span></summary>
          <p>{f.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .faq { background: var(--superficie); border-block: 1px solid var(--linha); }
  .faq__grade { display: grid; gap: 2.5rem; }
  @media (min-width: 60rem) { .faq__grade { grid-template-columns: 1fr 2fr; gap: 5rem; } }
  details { border-top: 1px solid var(--linha); }
  details:last-child { border-bottom: 1px solid var(--linha); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.25rem 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font: 700 1.02rem/1.4 var(--fonte-texto); text-transform: none; letter-spacing: 0; }
  .faq__mais { position: relative; flex: none; width: 1.75rem; height: 1.75rem; border-radius: 50%; border: 1px solid var(--destaque); }
  .faq__mais::before, .faq__mais::after { content: ''; position: absolute; inset: 50% 0.45rem auto; height: 1.5px; background: var(--destaque); transition: transform 0.3s var(--ease); }
  .faq__mais::after { transform: rotate(90deg); }
  details[open] .faq__mais::after { transform: rotate(0); }
  details p { padding-bottom: 1.4rem; color: var(--texto-suave); max-width: 46rem; }
</style>
