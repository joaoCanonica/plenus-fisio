---
// Ilustrações suaves por área, em traço único (currentColor) dentro de uma oval.
// Lúdicas, mas nunca infantilizadas; sempre decorativas (aria-hidden).
import type { IdArea } from '../../config/profile.config.ts';
interface Props { area: IdArea; class?: string }
const { area, class: cls } = Astro.props;
---
<svg class:list={['ilu', cls]} viewBox="0 0 120 160" aria-hidden="true" focusable="false">
  <ellipse class="ilu__oval" cx="60" cy="80" rx="54" ry="74" />
  {area === 'obstetricaPelvica' && (
    <g class="ilu__traco">
      <circle cx="60" cy="48" r="10" />
      <path d="M52 62c-10 10-12 30-6 44M68 62c12 6 18 22 14 36-3 10-12 14-22 12" />
      <path d="M48 126h24" />
    </g>
  )}
  {area === 'esportiva' && (
    <g class="ilu__traco">
      <circle cx="70" cy="44" r="9" />
      <path d="M64 56 52 84l18 10-6 30M52 84l-14 18M60 66l20 8 10-10" />
      <path d="M34 132h52" />
    </g>
  )}
  {area === 'traumatoOrtopedica' && (
    <g class="ilu__traco">
      <path d="M60 30v38M60 92v38" />
      <circle cx="60" cy="80" r="12" />
      <path d="M44 38h32M44 122h32" />
    </g>
  )}
  {area === 'pilates' && (
    <g class="ilu__traco">
      <circle cx="40" cy="96" r="8" />
      <path d="M48 98c14-2 26-14 34-30M48 102h38" />
      <path d="M30 116h62M38 116v10M84 116v10" />
    </g>
  )}
  {area === 'geriatrica' && (
    <g class="ilu__traco">
      <circle cx="58" cy="44" r="9" />
      <path d="M58 56v34l-10 34M58 90l12 34M58 66l18 10M80 70v58" />
    </g>
  )}
</svg>
<style>
  .ilu { display: block; width: 100%; height: auto; }
  .ilu__oval { fill: var(--acento); }
  .ilu__traco { fill: none; stroke: var(--acento-texto); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
</style>
