---
// Botão/link de ação. Primário = cor de ação; secundário = contorno.
import Icon from './Icon.astro';
type Nome = 'whatsapp' | 'instagram' | 'seta' | 'externo' | 'mapa';
interface Props {
  href?: string;
  variante?: 'primario' | 'secundario';
  icone?: Nome;
  externo?: boolean;
  type?: 'button' | 'submit';
  class?: string;
}
const { href, variante = 'primario', icone, externo = false, type = 'button', class: cls } = Astro.props;
const classes = ['btn', variante === 'secundario' && 'btn--linha', cls];
---
{href ? (
  <a class:list={classes} href={href} target={externo ? '_blank' : undefined} rel={externo ? 'noopener' : undefined}>
    {icone && <Icon nome={icone} />}<slot />{externo && <span class="sr-only"> (abre em nova aba)</span>}
  </a>
) : (
  <button class:list={classes} type={type}>{icone && <Icon nome={icone} />}<slot /></button>
)}
