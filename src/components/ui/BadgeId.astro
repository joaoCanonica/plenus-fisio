---
// Selo de identificação. Sem `profissional`: linha da pessoa jurídica (COFFITO).
// Com `profissional` (id da equipe): nome completo + CREFITO, só se visível;
// senão cai na identificação da clínica (nunca mostra nome sem CREFITO).
import Provisorio from '../Provisorio.astro';
import { clinica } from '../../config/profile.config.ts';
import { provisorio } from '../../lib/modo.ts';
import { profissionalVisivel, registroEmpresa, responsavelTecnico } from '../../lib/clinica.ts';
interface Props { compacto?: boolean; profissional?: string | null | undefined }
const { compacto = false, profissional } = Astro.props;
const p = profissionalVisivel(profissional);
const rt = responsavelTecnico();
const prov = provisorio(clinica.registroEmpresaCrefito) || provisorio(clinica.responsavelTecnico.nome) || provisorio(clinica.responsavelTecnico.crefito);
---
<p class:list={['badge-id', { 'badge-id--compacto': compacto }]}>
  {p ? (
    <>
      <span class="badge-id__nome">{p.nomeCompleto}</span>
      <span aria-hidden="true">·</span>
      <span>Fisioterapeuta</span>
      <span aria-hidden="true">·</span>
      <span>{p.registro}</span>
    </>
  ) : (
    <>
      <span class="badge-id__nome">{clinica.nomeFantasia.valor}</span>
      <span aria-hidden="true">·</span>
      <span>Registro {registroEmpresa()}</span>
      <span aria-hidden="true">·</span>
      <span>RT: {rt.nome}, {rt.registro}</span>
      <Provisorio ativo={prov} titulo="Registro da empresa e responsável técnico a informar" />
    </>
  )}
</p>
<style>
  .badge-id {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--superficie);
    border: 1px solid var(--linha);
    color: var(--texto);
    font: 700 0.78rem/1.3 var(--fonte-texto);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .badge-id__nome { color: var(--destaque); }
  .badge-id--compacto { padding: 0; border: 0; background: none; font: 400 0.92rem/1.5 var(--fonte-texto); letter-spacing: 0; text-transform: none; color: var(--texto-suave); }
  .badge-id--compacto .badge-id__nome { color: var(--texto); font-weight: 700; }
</style>
