---
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import InstagramBloco from './InstagramBloco.astro';
import { copy } from '../config/copy.config.ts';
import { instagramUrl, whatsappUrl } from '../lib/contato.ts';
import { canaisDisponiveis } from '../lib/clinica.ts';
const ig = instagramUrl();
// Canais confirmados; sem nenhum (preview), o botão geral provisório.
const canais = canaisDisponiveis();
const c = copy.contato;
---
<section id="contato" class="sec contato tom-verde" aria-labelledby="contato-titulo">
  <div class="wrap contato__grade">
    <div class="contato__cta" data-revelar>
      <h2 id="contato-titulo" class="titulo">{c.titulo}</h2>
      <p class="contato__txt">{c.texto}</p>
      <div class="contato__acoes">
        {canais.length > 1
          ? canais.map((k) => <Button href={k.url} icone="whatsapp" externo>{k.rotulo}</Button>)
          : <Button href={canais[0]?.url ?? whatsappUrl()} icone="whatsapp" externo>Falar no WhatsApp</Button>}
      </div>
    </div>
    {ig && (
      <div data-revelar style="--i:1">
        <h3 class="contato__h3"><Icon nome="instagram" /> Instagram</h3>
        {c.instagram && <p class="contato__txt">{c.instagram}</p>}
        <InstagramBloco />
      </div>
    )}
  </div>
</section>

<style>
  .contato__ilu { width: 5rem; margin-bottom: 1.5rem; }
  .contato__grade { display: grid; gap: 3.5rem; }
  @media (min-width: 60rem) { .contato__grade { grid-template-columns: 1.1fr 1fr; gap: 5rem; align-items: start; } }
  .contato__txt { color: var(--texto-suave); margin-top: 1.1rem; max-width: 36rem; }
  .contato__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .contato__h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font: 700 0.75rem/1 var(--fonte-texto);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--destaque);
  }
  .contato__h3 :global(svg) { width: 1.1rem; height: 1.1rem; }
</style>
