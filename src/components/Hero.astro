---
// Hero assimétrico. Esquerda: título grande (uma palavra em itálico), subtítulo
// curto, CTAs e identificação PJ discreta. Direita: arte aprovada `hero-4x5`
// numa oval que se desenha ao carregar, com o símbolo da marca sobre a borda.
// Se houver foto do ESPAÇO liberada, ela vira a mídia principal e a arte vai
// para o fundo. Fundo em duas camadas: textura de papel + bloco sálvia (1/3).
// Logo abaixo: faixa contínua com as áreas ativas (CSS; pausa no hover;
// parada com prefers-reduced-motion).
import Button from './ui/Button.astro';
import BadgeId from './ui/BadgeId.astro';
import Arte from './ui/Arte.astro';
import Marca from './Marca.astro';
import Provisorio from './Provisorio.astro';
import { copy } from '../config/copy.config.ts';
import { areasAtivas, whatsappUrl } from '../lib/clinica.ts';
import { instagramUrl } from '../lib/contato.ts';
import { imagemLiberada, manifesto } from '../lib/manifesto.ts';
import { EM_PRODUCAO, provisorio } from '../lib/modo.ts';

const ativas = areasAtivas().sort((x, y) => (x.cartao?.ordem ?? 9) - (y.cartao?.ordem ?? 9));
const rotulos = ativas.map((a) => a.cartao?.rotulo ?? a.titulo);
const lista = rotulos.map((r, i) => (i === 0 || r === 'Pilates' ? r : `${r.charAt(0).toLowerCase()}${r.slice(1)}`));
const subtitulo = `${lista.length <= 1 ? lista.join('') : `${lista.slice(0, -1).join(', ')} e ${lista.at(-1)}`}.`;
const ig = instagramUrl();

// "Fisioterapia e Pilates em Lages" → "Pilates" em itálico (se a palavra existir).
const titulo = copy.hero.titulo.valor;
const [antes, depois] = titulo.includes('Pilates') ? titulo.split('Pilates') : [titulo, null];

// Foto do espaço liberada (vira a mídia principal).
const fotoEspaco = manifesto.itens
  .filter((i) => i.categoria === 'espaco' && i.tipo === 'imagem')
  .map((i) => imagemLiberada(i.id, EM_PRODUCAO))
  .find((i) => i !== null);
const SIZES = '(min-width: 60rem) 30rem, 78vw';
---
<section id="inicio" class="hero tom-claro" aria-labelledby="hero-titulo">
  <div class="hero__textura" aria-hidden="true">
    <Arte id="ilustracao-textura-secao" sizes="100vw" decorativa />
  </div>
  <div class="hero__bloco tom-salvia" aria-hidden="true"></div>

  <div class="wrap hero__grade">
    <div class="hero__texto">
      <h1 id="hero-titulo" class="hero__h1">
        {antes}{depois !== null && <><em>Pilates</em>{depois}</>}
        <Provisorio ativo={provisorio(copy.hero.titulo)} titulo="Título a confirmar" />
      </h1>
      {rotulos.length > 0 && <p class="hero__sub">{subtitulo}</p>}
      <p class="hero__chamada">Agende uma consulta fisioterapêutica pelo WhatsApp.</p>
      <div class="hero__acoes">
        <Button href={whatsappUrl()} icone="whatsapp" externo>Falar no WhatsApp</Button>
        {ig && <Button href={ig} variante="secundario" icone="instagram" externo>Ver o Instagram</Button>}
      </div>
      <div class="hero__id"><BadgeId compacto /></div>
    </div>

    <div class="hero__midia">
      <div class="hero__oval papel">
        {fotoEspaco ? (
          <>
            <Arte id="ilustracao-hero-4x5" sizes={SIZES} class="hero__arte hero__arte--fundo" decorativa />
            <Arte id={fotoEspaco.id} sizes={SIZES} class="hero__arte" prioridade />
            {!fotoEspaco.publicavel && <span class="hero__selo"><Provisorio ativo titulo="Foto sem liberação: só em preview" /></span>}
          </>
        ) : (
          <Arte id="ilustracao-hero-4x5" sizes={SIZES} class="hero__arte" prioridade decorativa />
        )}
      </div>
      <svg class="hero__traco" viewBox="0 0 400 500" aria-hidden="true" focusable="false">
        <ellipse cx="200" cy="250" rx="196" ry="246" pathLength="1" />
      </svg>
      <span class="hero__simbolo"><Marca variante="simbolo" decorativa /></span>
    </div>
  </div>
</section>

{rotulos.length > 0 && (
  <div class="faixa tom-noite" aria-hidden="true">
    <div class="faixa__trilho">
      {[0, 1].map(() => (
        <ul class="faixa__lista">
          {rotulos.map((r) => <li>{r}<span class="faixa__oval"></span></li>)}
        </ul>
      ))}
    </div>
  </div>
)}

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(3.5rem, 8vw, 7rem);
  }
  .hero__textura { position: absolute; inset: 0; z-index: 0; opacity: 0.55; pointer-events: none; }
  .hero__textura :global(picture), .hero__textura :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* Bloco sálvia: um terço da largura, sai da grade (ponta a ponta à direita). */
  .hero__bloco {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    bottom: 22%;
    width: 34%;
    background: var(--fundo);
  }
  .hero__grade { position: relative; z-index: 1; display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  @media (min-width: 60rem) { .hero__grade { grid-template-columns: 1.25fr 0.75fr; } }

  .hero__h1 {
    font-size: clamp(3rem, 1.4rem + 7vw, 7.2rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    max-width: 11ch;
  }
  .hero__h1 em { font-style: italic; color: var(--destaque); }
  .hero__sub { margin-top: 1.75rem; max-width: 30rem; font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); color: var(--texto-suave); }
  .hero__chamada { margin-top: 0.5rem; font-weight: 600; }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__id { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--linha); max-width: 34rem; font-size: 0.85rem; }

  .hero__midia { position: relative; justify-self: center; width: min(78vw, 30rem); }
  .hero__oval { position: relative; aspect-ratio: 4 / 5; border-radius: 50%; overflow: hidden; box-shadow: var(--sombra-suave); }
  .hero__arte, .hero__arte :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .hero__arte--fundo { position: absolute; inset: 0; opacity: 0.35; }
  .hero__selo { position: absolute; top: 12%; left: 50%; translate: -50% 0; }
  /* Oval do logo se desenhando em volta da arte. */
  .hero__traco {
    position: absolute;
    inset: -3%;
    width: 106%;
    height: 106%;
    overflow: visible;
    pointer-events: none;
  }
  .hero__traco ellipse {
    fill: none;
    stroke: var(--destaque);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: hero-traco 1.6s cubic-bezier(0.45, 0, 0.2, 1) 0.2s both;
  }
  @keyframes hero-traco { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  /* Símbolo sobreposto na borda da oval. */
  .hero__simbolo {
    position: absolute;
    left: -0.5rem;
    bottom: 12%;
    display: grid;
    place-items: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background: var(--acao);
    color: var(--acao-texto);
    box-shadow: var(--sombra-suave);
  }
  .hero__simbolo :global(svg) { width: 1.6rem; height: auto; }

  @media (max-width: 59.99rem) {
    .hero__bloco { width: 45%; bottom: 55%; }
    .hero__midia { width: min(62vw, 16rem); }
  }

  /* Faixa contínua com as áreas ativas. */
  .faixa { overflow: hidden; padding-block: 1.1rem; background: var(--fundo); color: var(--texto); }
  .faixa__trilho { display: flex; width: max-content; animation: faixa 38s linear infinite; }
  .faixa:hover .faixa__trilho { animation-play-state: paused; }
  .faixa__lista { display: flex; list-style: none; margin: 0; padding: 0; }
  .faixa__lista li {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    white-space: nowrap;
    font: 400 clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem)/1 var(--fonte-display);
  }
  .faixa__oval { width: 0.7rem; height: 1rem; border: 1.5px solid var(--destaque); border-radius: 50%; }
  @keyframes faixa { to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .hero__traco ellipse { animation: none; }
    .faixa__trilho { animation: none; }
  }
</style>
