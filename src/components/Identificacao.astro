---
// Identificação COFFITO da PESSOA JURÍDICA: nome fantasia, registro da empresa
// no CREFITO e responsável técnico (nome + CREFITO). Razão social e CNPJ são
// opcionais: vazios, somem.
import Provisorio from './Provisorio.astro';
import { clinica } from '../config/profile.config.ts';
import { exibir, provisorio } from '../lib/modo.ts';
import { registroEmpresa, responsavelTecnico } from '../lib/clinica.ts';
interface Props { variante?: 'cartao' | 'linha' }
const { variante = 'cartao' } = Astro.props;
const c = clinica;
const rt = responsavelTecnico();
const rtProv = provisorio(c.responsavelTecnico.nome) || provisorio(c.responsavelTecnico.crefito);
const regProv = provisorio(c.registroEmpresaCrefito);
const razao = exibir(c.razaoSocial);
const cnpj = exibir(c.cnpj);
---
{variante === 'cartao' ? (
  <dl class="id">
    <div>
      <dt>Clínica</dt>
      <dd>{c.nomeFantasia.valor}{razao && <span class="id__sec">{razao}</span>}{cnpj && <span class="id__sec">CNPJ {cnpj}</span>}</dd>
    </div>
    <div>
      <dt>Registro da empresa</dt>
      <dd>{registroEmpresa()}<Provisorio ativo={regProv} titulo="Registro da empresa no CREFITO a informar" /></dd>
    </div>
    <div>
      <dt>Responsável técnico</dt>
      <dd>{rt.nome} · Fisioterapeuta · {rt.registro}<Provisorio ativo={rtProv} titulo="Responsável técnico a informar" /></dd>
    </div>
  </dl>
) : (
  <p class="id-linha">
    {c.nomeFantasia.valor} · Registro {registroEmpresa()} · RT: {rt.nome}, {rt.registro}
    <Provisorio ativo={regProv || rtProv} />
  </p>
)}

<style>
  .id { display: grid; gap: 1rem; margin: 0; }
  dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }
  dd { margin: 0; font-weight: 500; }
  .id__sec { display: block; font-weight: 400; color: var(--texto-suave); font-size: 0.88rem; }
  .id-linha { margin: 0; font-size: 0.88rem; color: var(--texto-suave); }
</style>
