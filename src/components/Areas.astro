---
// Áreas ativas: uma seção por área, com o copy aprovado (o que é, quando
// procurar, o que esperar, fontes). Área inativa não aparece. Pilates segue
// pilates.conduzidoPorFisioterapeuta (lib/clinica.ts). Recursos: só os confirmados.
import Ilustracao from './ui/Ilustracao.astro';
import Fontes from './ui/Fontes.astro';
import Button from './ui/Button.astro';
import { copy, type ConteudoArea } from '../config/copy.config.ts';
import { areasAtivas, pilatesPorFisioterapeuta, recursosConfirmados } from '../lib/clinica.ts';
const c = copy.areas;
const conteudo = c.conteudo as Partial<Record<string, ConteudoArea>>;
const lista = areasAtivas().sort((x, y) => (x.cartao?.ordem ?? 9) - (y.cartao?.ordem ?? 9));
const pilatesClinico = pilatesPorFisioterapeuta();
const recursos = recursosConfirmados();
---
{lista.length > 0 && (
  <section id="areas" class="sec areas tom-claro" aria-labelledby="areas-titulo">
    <div class="wrap">
      <div class="areas__topo" data-revelar>
        <h2 id="areas-titulo" class="titulo">{c.titulo}</h2>
        <p class="lead">{c.intro}</p>
        <p class="areas__data">As afirmações de saúde desta página citam a fonte. Fontes consultadas em {c.fontesConsultadasEm}.</p>
      </div>
      <div class="areas__lista">
        {lista.map((a) => {
          const t = conteudo[a.id];
          return (
            <article class="area" id={`area-${a.id}`} aria-labelledby={`area-${a.id}-t`} data-revelar>
              <div class="area__ilu"><Ilustracao area={a.id} /></div>
              <div class="area__corpo">
                <h3 id={`area-${a.id}-t`} class="area__t">{a.cartao?.rotulo ?? a.titulo}</h3>
                {a.id === 'pilates' ? (
                  pilatesClinico ? (
                    <>
                      <p>{c.pilates.comFisioterapeuta.texto}</p>
                      <Fontes fontes={c.pilates.comFisioterapeuta.fontes} />
                    </>
                  ) : (
                    <p>{c.pilates.semFisioterapeuta}</p>
                  )
                ) : t && (
                  <>
                    <p>{t.oQueE}</p>
                    <div class="area__cols">
                      <div>
                        <h4>{c.rotulos.quando}</h4>
                        <ul>{t.quando.map((q) => <li>{q}</li>)}</ul>
                      </div>
                      <div>
                        <h4>{c.rotulos.esperar}</h4>
                        <ul>{t.esperar.map((e) => <li>{e.texto}</li>)}</ul>
                      </div>
                    </div>
                    {t.sub && (
                      <div class="area__sub">
                        <h4>{t.sub.titulo}</h4>
                        <p>{t.sub.oQueE}</p>
                        <p><strong>{c.rotulos.quando}:</strong> {t.sub.quando}</p>
                        <ul>{t.sub.esperar.map((e) => <li>{e.texto}</li>)}</ul>
                        {t.sub.fontes.length > 0 && <Fontes fontes={t.sub.fontes} />}
                      </div>
                    )}
                    {t.fontes.length > 0 && <Fontes fontes={t.fontes} />}
                  </>
                )}
                {a.equipe.length > 0 && <p class="area__quem">Com {a.equipe.map((p) => `${p.nomeCompleto} (${p.registro})`).join(' e ')}</p>}
                <div class="area__cta">
                  <Button href={a.whatsapp} variante="secundario" icone="whatsapp" externo>
                    {a.id === 'pilates' ? 'Saber como funciona' : 'Agendar pelo WhatsApp'}
                  </Button>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      {recursos.length > 0 && (
        <div class="areas__recursos" data-revelar>
          <h3>{c.recursos.titulo}</h3>
          <p>{c.recursos.texto}</p>
          <ul>{recursos.map((r) => <li>{r.nome}</li>)}</ul>
        </div>
      )}
    </div>
  </section>
)}
<style>
  .areas__data { margin-top: 0.75rem; font-size: 0.85rem; color: var(--texto-suave); }
  .areas__lista { display: grid; gap: clamp(1.5rem, 4vw, 2.5rem); margin-top: 3rem; }
  .area {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--raio-g);
    background: var(--superficie);
    border: 1px solid var(--linha);
  }
  @media (min-width: 48rem) { .area { grid-template-columns: 9rem 1fr; align-items: start; } }
  .area__ilu { width: 7rem; }
  @media (min-width: 48rem) { .area__ilu { width: 9rem; } }
  .area__t { font: 400 clamp(1.7rem, 1.3rem + 1.4vw, 2.3rem)/1.1 var(--fonte-display); }
  .area__corpo > p { margin-top: 0.75rem; color: var(--texto-suave); max-width: 46rem; }
  .area__cols { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  @media (min-width: 60rem) { .area__cols { grid-template-columns: 1fr 1fr; } }
  .area h4 { font: 600 0.95rem/1.3 var(--fonte-texto); color: var(--destaque); margin: 0 0 0.5rem; }
  .area ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.4rem; color: var(--texto-suave); }
  .area__sub { margin-top: 1.5rem; padding: 1.25rem; border-radius: var(--raio); background: var(--superficie-alt); }
  .area__sub p { margin-top: 0.4rem; color: var(--texto-suave); }
  .area__sub ul { margin-top: 0.6rem; }
  .area__quem { font-size: 0.88rem; }
  .area__cta { margin-top: 1.5rem; }
  .areas__recursos { margin-top: 2.5rem; max-width: 46rem; }
  .areas__recursos p { margin-top: 0.5rem; color: var(--texto-suave); }
  .areas__recursos ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding-left: 1.2rem; margin-top: 0.75rem; }
</style>
