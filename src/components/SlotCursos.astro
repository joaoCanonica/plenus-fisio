---
// Slot "Cursos" (módulo futuro). Com cursos.ativo = false, não renderiza nada.
import { cursos } from '../config/cursos.config.ts';
const ativo = cursos.ativo && cursos.itens.length > 0;
---
{ativo && (
  <section id="cursos" class="sec tom-claro" aria-labelledby="cursos-titulo">
    <div class="wrap">
      <h2 id="cursos-titulo" class="titulo">{cursos.titulo}</h2>
      <ul class="cursos__lista">
        {cursos.itens.map((c) => <li><h3>{c.titulo}</h3><p>{c.resumo}</p></li>)}
      </ul>
    </div>
  </section>
)}
<style>
  .cursos__lista { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1rem; }
</style>
