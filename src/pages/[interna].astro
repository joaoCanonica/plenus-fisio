---
// Página de pendências: só é gerada em dev/preview, nunca em produção.
import Base from '../layouts/Base.astro';
import { EM_PRODUCAO } from '../lib/modo.ts';
import { GRUPOS, listarPendencias } from '../lib/validacao.ts';
export function getStaticPaths() {
  return EM_PRODUCAO ? [] : [{ params: { interna: 'pendencias' } }];
}
const ps = listarPendencias();
const grupos = [
  ['bloqueante', 'Bloqueantes para produção'],
  ['aviso', 'Avisos'],
] as const;
---
<Base titulo="Pendências · preview" descricao="Lista de pendências do site (somente preview).">
  <section class="sec wrap">
    <p class="eyebrow">Somente preview</p>
    <h1 class="titulo">Pendências</h1>
    <p class="lead">Edite <code>src/config/*.ts</code> e <code>media.manifest.json</code>. O build de produção (<code>npm run build</code>) falha enquanto houver item bloqueante.</p>
    {grupos.map(([nivel, rotulo]) => {
      const lista = ps.filter((p) => p.nivel === nivel);
      return (
        <div class="grupo">
          <h2>{rotulo} ({lista.length})</h2>
          {GRUPOS.map((g) => {
            const doGrupo = lista.filter((p) => p.grupo === g);
            return doGrupo.length > 0 && (
              <>
                <h3>{g}</h3>
                <ul>{doGrupo.map((p) => <li><code>{p.campo.replace(/^\./, '')}</code><span>{p.nota}</span></li>)}</ul>
              </>
            );
          })}
        </div>
      );
    })}
  </section>
</Base>

<style>
  .grupo { margin-top: 3rem; }
  .grupo h2 { font-size: 1.5rem; margin-bottom: 1rem; }
  .grupo h3 { font: 700 0.75rem/1 var(--fonte-texto); letter-spacing: 0.14em; text-transform: uppercase; color: var(--texto-suave); margin: 1.5rem 0 0.75rem; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  li { display: grid; gap: 0.2rem; padding: 0.9rem 1rem; background: var(--superficie); border: 1px solid var(--linha); border-radius: 0.75rem; }
  code { font-size: 0.82rem; color: var(--destaque); }
</style>
