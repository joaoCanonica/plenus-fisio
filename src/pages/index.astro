---
// Esqueleto da landing: só a estrutura herdada do template, sem conteúdo de saúde.
// As seções da Plenus entram depois do copy deck aprovado (ver docs/ARQUITETURA.md).
import Base from '../layouts/Base.astro';
import SlotConvite from '../components/SlotConvite.astro';
import SlotAtendimentos from '../components/SlotAtendimentos.astro';
import Hero from '../components/Hero.astro';
import PorOndeComecar from '../components/PorOndeComecar.astro';
import Equipe from '../components/Equipe.astro';
import Areas from '../components/Areas.astro';
import PrimeiraConsulta from '../components/PrimeiraConsulta.astro';
import FraseMarca from '../components/FraseMarca.astro';
import GaleriaEspaco from '../components/GaleriaEspaco.astro';
import SlotCursos from '../components/SlotCursos.astro';
import Onde from '../components/Onde.astro';
import Faq from '../components/Faq.astro';
import Contato from '../components/Contato.astro';
import { clinica } from '../config/profile.config.ts';
import { areasAtivas } from '../lib/clinica.ts';
// SEO: especialidade + cidade, sem superlativo. Descrição gerada das áreas ativas.
const CURTO: Record<string, string> = {
  traumatoOrtopedica: 'ortopédica',
  esportiva: 'esportiva',
  obstetricaPelvica: 'obstétrica',
  geriatrica: 'geriátrica',
};
const areas = areasAtivas().map((a) => CURTO[a.id]).filter(Boolean);
const temPilates = areasAtivas().some((a) => a.id === 'pilates');
const lista = areas.length <= 1 ? areas.join('') : `${areas.slice(0, -1).join(', ')} e ${areas.at(-1)}`;
const titulo = `Fisioterapia${temPilates ? ' e Pilates' : ''} em Lages (SC) | ${clinica.nomeFantasia.valor.split(' ')[0]}`;
const descricao = `${clinica.nomeFantasia.valor}, em Lages (SC): fisioterapia ${lista}${temPilates ? ', e Pilates' : ''}. Agende pelo WhatsApp.`;
---
<Base titulo={titulo} descricao={descricao} landing faq>
  <Hero />
  <SlotConvite />
  <PorOndeComecar />
  <Equipe />
  <Areas />
  <FraseMarca />
  <PrimeiraConsulta />
  <GaleriaEspaco />
  <SlotAtendimentos />
  <SlotCursos />
  <Onde />
  <Faq />
  <Contato />
</Base>
