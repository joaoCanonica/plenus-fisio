---
// /_kit: vitrine do design system (noindex). Arquivos com "_" são ignorados
// como página pelo Astro, por isso a rota é dinâmica.
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import Link from '../components/ui/Link.astro';
import Card from '../components/ui/Card.astro';
import Tag from '../components/ui/Tag.astro';
import Icon from '../components/ui/Icon.astro';
import MediaOval from '../components/ui/MediaOval.astro';
import MediaFrame from '../components/ui/MediaFrame.astro';
import VideoFrame from '../components/ui/VideoFrame.astro';
import BadgeId from '../components/ui/BadgeId.astro';
import Identificacao from '../components/Identificacao.astro';
import Marca from '../components/Marca.astro';
import { theme, type Tokens } from '../config/theme.config.ts';
import { verificarContraste } from '../lib/tema.ts';

export function getStaticPaths() {
  return [{ params: { kit: '_kit' } }];
}

const tons = ['claro', 'escuro', 'verde'] as const;
const esquemas = ['claro', 'escuro'] as const;
const resultados = verificarContraste();
const tokens = Object.keys(theme.esquemas.claro) as (keyof Tokens)[];
const kebab = (s: string) => s.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`);
const icones = ['whatsapp', 'instagram', 'seta', 'externo', 'mapa'] as const;
// Sem mídia real: o kit é público e não exibe pacientes nem fotos sem autorização.
---
<Base titulo="Kit · design system" descricao="Componentes e tokens do design system (uso interno)." noindex>
  <Section tom="claro" compacta>
    <Container>
      <Eyebrow>Design system · Plenus</Eyebrow>
      <h1 class="kit-h1">Leve, acolhedor e <em>claro</em></h1>
      <p class="lead">Verde amostrado do logo, sálvia, areia, off-white quente, grafite esverdeado e um acento terracota pontual. Display em Instrument Serif, texto em Figtree (self-hosted). Todas as cores vêm de <code>src/config/theme.config.ts</code>.</p>
      <div class="kit-marcas">
        <Marca class="kit-logo-h" />
        <Marca class="kit-logo-o" variante="oval" />
        <Marca class="kit-logo-s" variante="simbolo" />
      </div>
    </Container>
  </Section>

  <Section tom="claro" compacta>
    <Container>
      <h2 class="kit-h2">Tokens nos dois esquemas</h2>
      <div class="kit-esqs">
        {esquemas.map((esq) => (
          <div data-tema={esq} class="kit-esq tom-claro">
            <p class="kit-rot">Esquema {esq}</p>
            <ul class="kit-tokens">
              {tokens.map((t) => (
                <li><span class="kit-sw" style={`background: var(--${kebab(t)})`}></span><code>--{kebab(t)}</code></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <h2 class="kit-h2">Contraste AA ({resultados.filter((r) => r.ok).length}/{resultados.length} pares aprovados)</h2>
      <div class="kit-rolagem" tabindex="0" role="region" aria-label="Tabela de contraste">
        <table class="kit-tab">
          <thead><tr><th scope="col">Contexto</th><th scope="col">Par</th><th scope="col">Razão</th><th scope="col">Mínimo</th><th scope="col">Status</th></tr></thead>
          <tbody>
            {resultados.map((r) => (
              <tr><td>{r.contexto}</td><td>{r.frente} / {r.fundo}</td><td>{r.razao.toFixed(2)}:1</td><td>{r.minimo}:1</td><td>{r.ok ? 'AA ✔' : 'falha ✖'}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </Section>

  {esquemas.map((esq) => (
    <div data-tema={esq}>
      {tons.map((tom) => (
        <Section tom={tom} compacta>
          <Container>
            <Eyebrow>Tom {tom} · esquema {esq}</Eyebrow>
            <h2 class="kit-h2">Fisioterapia e <em>Pilates</em> em Lages</h2>
            <h3 class="kit-h3">Subtítulo em Figtree</h3>
            <p>Texto corrido em Figtree, com respiro generoso. <span class="kit-suave">Texto suave para apoio.</span> <Link href="#">Link interno</Link> · <Link href="https://www.coffito.gov.br/" externo>Link externo</Link></p>
            <div class="kit-linha">
              <Button href="#" icone="whatsapp">Primário</Button>
              <Button href="#" variante="secundario" icone="instagram">Secundário</Button>
              <Button>Botão</Button>
            </div>
            <div class="kit-linha">
              <Tag>Neutra</Tag><Tag variante="acento">Sálvia</Tag><Tag variante="quente">Destaque</Tag>
              {icones.map((i) => <span class="kit-ico" title={i}><Icon nome={i} /></span>)}
            </div>
            <div class="kit-cards">
              <Card><h3 class="kit-h3">Card</h3><p>Superfície padrão, cantos suaves.</p></Card>
              <Card destaque><h3 class="kit-h3">Card destaque</h3><p>Superfície alternativa (areia).</p></Card>
              <Card><BadgeId /><p class="kit-mt">Badge de identificação da clínica</p></Card>
            </div>
          </Container>
        </Section>
      ))}
    </div>
  ))}

  {esquemas.map((esq) => (
    <div data-tema={esq}>
      <Section tom="claro" compacta>
        <Container>
          <h2 class="kit-h2">Mídia e identificação · esquema {esq}</h2>
          <div class="kit-midia">
            <MediaOval formato="4:5">
              <div class="kit-ph">MediaOval 4:5 (foto real aqui)</div>
              <figcaption slot="legenda">MediaOval 4:5</figcaption>
            </MediaOval>
            <MediaOval formato="9:16" contorno><div class="kit-ph">MediaOval 9:16 com contorno</div><figcaption slot="legenda">Contorno (oval do logo)</figcaption></MediaOval>
            <MediaFrame formato="4:5"><div class="kit-ph">MediaFrame 4:5</div><figcaption slot="legenda">Retângulo suave</figcaption></MediaFrame>
            <VideoFrame formato="9:16" oval rotulo="Exemplo de VideoFrame oval, sem vídeo" fontes={[]} dataRegistro={null} />
          </div>
          <div class="kit-id"><Identificacao /></div>
        </Container>
      </Section>
    </div>
  ))}
</Base>

<style>
  .kit-h1 { font-size: clamp(2.6rem, 1.6rem + 4vw, 4.6rem); margin-top: 1rem; }
  .kit-h2 { font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem); margin: 2.5rem 0 1rem; }
  .kit-h3 { font-size: 1.05rem; margin-bottom: 0.4rem; }
  .kit-marcas { display: flex; flex-wrap: wrap; align-items: center; gap: 2.5rem; margin-top: 2.5rem; color: var(--marca); }
  .kit-marcas :global(.kit-logo-h) { height: 4rem; width: auto; }
  .kit-marcas :global(.kit-logo-o) { height: 9rem; width: auto; }
  .kit-marcas :global(.kit-logo-s) { height: 4rem; width: auto; }
  .kit-esqs { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .kit-esq { padding: 1.25rem; border-radius: var(--raio); border: 1px solid var(--linha); }
  .kit-rot { font-weight: 700; margin-bottom: 0.75rem; }
  .kit-tokens { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); }
  .kit-tokens li { display: flex; align-items: center; gap: 0.6rem; font-size: 0.82rem; }
  .kit-sw { width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid var(--linha); flex: none; }
  .kit-rolagem { overflow-x: auto; }
  .kit-tab { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .kit-tab th, .kit-tab td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--linha); }
  .kit-linha { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 1.5rem; }
  .kit-ico { display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; border: 1px solid var(--linha); color: var(--destaque); }
  .kit-ico :global(svg) { width: 1.2rem; height: 1.2rem; }
  .kit-cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); margin-top: 1.5rem; }
  .kit-suave { color: var(--texto-suave); }
  .kit-mt { margin-top: 1rem; }
  .kit-midia { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); align-items: start; }
  .kit-ph { height: 100%; display: grid; place-items: center; padding: 1rem; text-align: center; color: var(--acento-texto); font-size: 0.85rem; }
  .kit-id { margin-top: 2.5rem; max-width: 36rem; }
</style>
